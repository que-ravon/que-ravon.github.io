---
import Icon from "./Icon.astro";
import { isExternal } from "../lib/inline";

interface Props {
  links: { label: string; href: string }[];
}
const { links } = Astro.props;
---

{
  links.length > 0 && (
    <div class="links">
      {links.map((l) => (
        <a href={l.href} rel={isExternal(l.href) ? "noopener" : undefined}>
          {l.label}
          {isExternal(l.href) && <Icon name="arrow" size={13} />}
        </a>
      ))}
    </div>
  )
}
