---
import { list } from "../lib/content";
import Base from "../layouts/Base.astro";
import Links from "../components/Links.astro";
import { site } from "../site.config";
import { authorList, inline } from "../lib/inline";

const papers = await list("papers");
const research = await list("research");
---

<Base
  title="Research"
  description="Research by Naman Goyal: the quantum query complexity of minimum weight cycles, and a measurement study of open-source RISC-V processor security at CISPA."
>
  <div class="page">
    <h1 class="page-title">Research</h1>
    <p class="page-lede">
      I am interested in the cost of computation: how many queries, cycles or nanoseconds a problem really needs, and how
      to prove it. So far this has meant quantum query complexity and the security of open hardware.
    </p>

    <section class="section" aria-labelledby="papers">
      <h2 class="section-title" id="papers">Papers</h2>
      <div class="entries">
        {
          papers.map((p) => (
            <article>
              <h3 class="paper-title">{p.data.title}</h3>
              <p class="paper-meta">
                <Fragment set:html={authorList(p.data.authors, site.name)} />
                <span class="faint">
                  {" "}
                  &middot; {p.data.venue}, {p.data.year}
                </span>
              </p>
              {p.data.abstract && (
                <details class="abstract">
                  <summary>Abstract</summary>
                  <p set:html={p.data.abstract} />
                </details>
              )}
              <Links links={p.data.links} />
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="projects">
      <h2 class="section-title" id="projects">Projects</h2>
      <div class="entries">
        {
          research.map((r) => (
            <article>
              <div class="entry-head">
                <h3 class="entry-title">
                  {r.data.title}
                  {r.data.status && <span class="badge">{r.data.status}</span>}
                </h3>
                <span class="entry-period">{r.data.period}</span>
              </div>
              <p class="entry-sub">
                {r.data.role}
                <span class="sep">&middot;</span>
                {r.data.org}
              </p>
              <p class="entry-summary" set:html={inline(r.data.summary)} />
              <ul class="bullets">
                {r.data.points.map((pt) => (
                  <li set:html={inline(pt)} />
                ))}
              </ul>
              <ul class="tags">
                {r.data.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
              <Links links={r.data.links} />
            </article>
          ))
        }
      </div>
    </section>
  </div>
</Base>
