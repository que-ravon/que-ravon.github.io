---
import { list } from "../lib/content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";
import { authorList, inline } from "../lib/inline";

const education = await list("education");
const roles = (await list("experience")).filter((r) => r.data.kind === "work");
const leadership = (await list("experience")).filter((r) => r.data.kind === "leadership");
const papers = await list("papers");
const projects = await list("projects");
const skills = await list("skills");
const top = (await list("achievements")).slice(0, 9);
---

<Base
  title="CV"
  description="Curriculum vitae of Naman Goyal: Electrical Engineering at IIT Delhi (Department Rank 1), research at CISPA, and incoming Software Engineering Intern at Virtu Financial."
>
  <div class="page">
    <h1 class="page-title">Curriculum Vitae</h1>
    <p class="page-lede">A summary is below. The PDF is the version to download and share.</p>
    <div class="btn-row">
      <a class="btn primary" href={site.cv} target="_blank" rel="noopener"><Icon name="file" />View PDF</a>
      <a class="btn" href={site.cv} download="Naman_Goyal_CV.pdf"><Icon name="download" />Download</a>
    </div>

    <section class="section" aria-labelledby="edu">
      <h2 class="section-title" id="edu">Education</h2>
      {
        education.map((e) => (
          <article>
            <div class="entry-head">
              <h3 class="entry-title">{e.data.school}</h3>
              <span class="entry-period">{e.data.period}</span>
            </div>
            <p class="entry-sub">{e.data.degree}</p>
            <ul class="bullets">
              {e.data.details.map((d) => (
                <li set:html={inline(d)} />
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="section" aria-labelledby="exp">
      <h2 class="section-title" id="exp">Experience</h2>
      <div class="entries">
        {
          roles.map((r) => (
            <article>
              <div class="entry-head">
                <h3 class="entry-title">
                  {r.data.org}
                  {r.data.upcoming && <span class="badge">Incoming</span>}
                </h3>
                <span class="entry-period">{r.data.period}</span>
              </div>
              <p class="entry-sub">
                {r.data.title}
                {r.data.location && (
                  <>
                    <span class="sep">&middot;</span>
                    {r.data.location}
                  </>
                )}
              </p>
              {r.data.points.length > 0 && (
                <ul class="bullets">
                  {r.data.points.map((pt) => (
                    <li set:html={inline(pt)} />
                  ))}
                </ul>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="pub">
      <h2 class="section-title" id="pub">Papers</h2>
      <ul class="bullets">
        {
          papers.map((p) => (
            <li>
              <Fragment set:html={authorList(p.data.authors, site.name)} />. <em>{p.data.title}</em>. {p.data.venue},{" "}
              {p.data.year}.{" "}
              {p.data.links[0] && (
                <a href={p.data.links[0].href} rel="noopener">
                  {p.data.links[0].label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="proj">
      <h2 class="section-title" id="proj">Projects</h2>
      <ul class="bullets">
        {
          projects.map((p) => (
            <li>
              <a href={`/experience/#${p.id}`} style="font-weight:600;color:var(--text)">{p.data.title}</a>
              <span class="faint"> &middot; {p.data.stack.slice(0, 3).join(", ")}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="hon">
      <h2 class="section-title" id="hon">Selected honors</h2>
      <ul class="bullets">
        {
          top.map((a) => (
            <li>
              <span style="color:var(--text);font-weight:600">{a.data.title}</span>
              <span class="faint"> &middot; {a.data.badge}</span>
            </li>
          ))
        }
      </ul>
      <p style="margin-top:.9rem;font-size:.93rem"><a href="/achievements/">All achievements</a></p>
    </section>

    <section class="section" aria-labelledby="lead">
      <h2 class="section-title" id="lead">Leadership</h2>
      <ul class="bullets">
        {
          leadership.map((r) => (
            <li>
              <span style="color:var(--text);font-weight:600">{r.data.title}</span>, {r.data.org}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="skills">
      <h2 class="section-title" id="skills">Skills</h2>
      <dl class="cv-row">
        {
          skills.map((s) => (
            <>
              <dt>{s.data.label}</dt>
              <dd>{s.data.items.join(", ")}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>
</Base>
