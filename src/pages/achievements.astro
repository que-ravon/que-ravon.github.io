---
import { list } from "../lib/content";
import Base from "../layouts/Base.astro";

const all = await list("achievements");
const phases = ["University", "Pre-University"] as const;

// keep yaml order inside each phase and group
const byPhase = phases.map((phase) => {
  const items = all.filter((a) => a.data.phase === phase);
  const groups = [...new Set(items.map((a) => a.data.group))];
  return { phase, groups: groups.map((g) => ({ name: g, items: items.filter((a) => a.data.group === g) })) };
});
---

<Base
  title="Achievements"
  description="Awards and olympiad results of Naman Goyal: hackathon wins at CISPA and Atlassian, USACO Platinum with a perfect score, INPhO and INAO gold, INMO awardee, and the Atlas Fellowship."
>
  <div class="page">
    <h1 class="page-title">Achievements</h1>
    <p class="page-lede">Competition results, awards and selective programs, from university back to school.</p>

    {
      byPhase.map(({ phase, groups }) => (
        <section class="section" aria-label={phase}>
          <h2 class="section-title">{phase}</h2>
          {groups.map((g) => (
            <>
              {groups.length > 1 && <h3 class="group-title">{g.name}</h3>}
              <ul class="awards">
                {g.items.map((a) => (
                  <li>
                    <span class="award-badge">{a.data.badge}</span>
                    <div>
                      <div class="award-title">{a.data.title}</div>
                      <p class="award-detail">{a.data.detail}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </>
          ))}
        </section>
      ))
    }
  </div>
</Base>
