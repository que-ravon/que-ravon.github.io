---
import { list } from "../lib/content";
import { Picture } from "astro:assets";
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../site.config";
import { inline, isExternal } from "../lib/inline";
import portrait from "../assets/portrait.jpg";

const home = await getEntry("pages", "home");
if (!home) throw new Error("src/content/pages/home.md is missing");
const { Content } = await render(home);

const news = await list("news");
const education = await list("education");
const next = (await list("experience")).find((r) => r.data.upcoming);
---

<Base>
  <div class="home">
    <aside class="profile" aria-label="Profile">
      <Picture
        src={portrait}
        alt="Naman Goyal"
        class="avatar"
        widths={[184, 368, 552]}
        sizes="184px"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
      />
      <h1>{site.name}</h1>
      <p class="role">Electrical Engineering<br />IIT Delhi</p>

      <ul class="profile-links">
        {
          site.links.map((l) => (
            <li>
              <a href={l.href} rel={isExternal(l.href) ? "me noopener" : undefined}>
                <Icon name={l.icon} />
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="side-block">
        <h2>Education</h2>
        <ul class="side-list">
          {
            education.map((e) => (
              <li>
                <Icon name="cap" />
                <span>
                  B.Tech., {e.data.short}
                  <small>{e.data.period}</small>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        next && (
          <div class="side-block">
            <h2>Next</h2>
            <ul class="side-list">
              <li>
                <Icon name="briefcase" />
                <span>
                  {next.data.org}
                  <small>{next.data.title}</small>
                  <small>
                    {next.data.location}, {next.data.period}
                  </small>
                </span>
              </li>
            </ul>
          </div>
        )
      }
    </aside>

    <div>
      <section class="bio" aria-label="About">
        <Content />
      </section>

      <section class="section" aria-labelledby="news">
        <h2 class="section-title" id="news">News</h2>
        <dl class="news">
          {
            news.map((n) => (
              <>
                <dt>{n.data.date}</dt>
                <dd>
                  <Fragment set:html={inline(n.data.text)} />
                  {n.data.href && (
                    <a class="more" href={n.data.href}>
                      More
                    </a>
                  )}
                </dd>
              </>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</Base>
